# ==============================================================================
# Kichuu Lagbe - Production Environment Variables
# Copy this file to .env on your server and update the values:
# cp .env.example .env
# ==============================================================================

# 1. Traefik & Domain Configuration
DOMAIN=kichuulagbe.ovijit.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERTRESOLVER=letsencrypt

# 2. Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret_min_32_characters_here
CLIENT_ORIGIN=https://kichuulagbe.ovijit.com

# 3. Database Configuration
# Use local container (default): mongodb://mongo:27017/kichuu_lagbe
# Or MongoDB Atlas cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/kichuu_lagbe?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/kichuu_lagbe

# 4. Optional: Initial Demo & Seed Accounts (run `docker compose exec api npm run seed`)
RESIDENT_NAME=Tanvir Ahmed
RESIDENT_EMAIL=tanvir@kichuulagbe.local
RESIDENT_PASSWORD=Resident123!

SHOP_OWNER_NAME=Bashundhara Fresh Hub
SHOP_OWNER_EMAIL=shop@kichuulagbe.local
SHOP_OWNER_PASSWORD=Shop12345!

PROVIDER_NAME=Kabir Ahmed
PROVIDER_EMAIL=kabir@kichuulagbe.local
PROVIDER_PASSWORD=Provider123!

RIDER_NAME=Hasan Rider
RIDER_EMAIL=hasan@kichuulagbe.local
RIDER_PASSWORD=Rider1234!

ADMIN_NAME=Kichuu Admin
ADMIN_EMAIL=admin@kichuulagbe.local
ADMIN_PASSWORD=Admin1234!
